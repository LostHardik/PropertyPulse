PORT=3000
# Docker only: set Y after reviewing Microsoft's SQL Server license terms.
ACCEPT_EULA=
DB_HOST=localhost
DB_PORT=1433
DB_NAME=PropertyPulse
DB_USER=sa
DB_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
DB_ENCRYPT=false
DB_TRUST_CERT=true
JWT_SECRET=REPLACE_WITH_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
# Local portfolio testing only. Set false before any public deployment.
DEMO_MODE=true
BUSINESS_TIME_ZONE=Asia/Kolkata
ADMIN_EMAIL=admin@propertypulse.example
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
VIEWER_EMAIL=viewer@propertypulse.example
VIEWER_PASSWORD=REPLACE_WITH_STRONG_VIEWER_PASSWORD
# Integration tests ONLY: a separate disposable database with this exact suffix.
TEST_DB_NAME=PropertyPulse_test
